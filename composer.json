{
    "name": "lawrancebabu/wc-order-sync-recovery",
    "description": "Reliable WooCommerce to ERP order sync: background jobs, signed webhooks, retries and recovery. HPOS compatible.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "WCOSR\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WCOSR\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l > /dev/null"
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Lawrance Babu Gain",
            "email": "lawrance1020@gmail.com",
            "homepage": "https://github.com/lawrancebabu"
        }
    ]
}
